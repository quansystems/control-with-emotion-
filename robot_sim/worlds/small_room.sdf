  <model name="yolo_bottle"><static>true</static><pose>2.5 -0.5 0 0 0 0</pose><link name="body">
    <collision name="body_collision"><pose>0 0 0.26 0 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.52</length></cylinder></geometry></collision>

    <!-- Textured water-bottle mesh; retain the original collision footprint for the saved map. -->
    <visual name="water_bottle_visual">
      <geometry><mesh><uri>assets/water_bottle/water_bottle.dae</uri></mesh></geometry>
    </visual>
  </link></model>
  <!-- Static human prop, OpenRobotics Standing person v3 (CC0).
       Local mesh/textures: worlds/assets/standing_person; attribution in SOURCE.txt.
       Placed south of spawn, away from boxes and the central doorway. -->
  <model name="yolo_person">
    <static>true</static>
    <pose>0 -2.0 0 0 0 0</pose>
    <link name="body">
      <collision name="person_collision">
        <pose>0 -0.05 0.9 0 0 0</pose>
        <geometry><box><size>0.55 0.4 1.8</size></box></geometry>
